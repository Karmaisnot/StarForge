# StarForge EDU staff frontend — production tenant backend.
VITE_DATA_SOURCE=local
# Vite proxies this local username/password API during development.
VITE_API_PROXY_TARGET=http://127.0.0.1:4000

# Leave blank when the SPA is served from the same tenant domain. Otherwise
# use the remote API origin.
# VITE_API_BASE_URL=

# Optional remote v1 integration. It must expose a real password endpoint.
# VITE_DATA_SOURCE=remote
# VITE_API_BASE_URL=https://your-api.example.edu
# VITE_AUTH_ENDPOINT=auth/login

# Explicit visual-only mode. Never use in a deployed environment.
# VITE_DATA_SOURCE=mock
