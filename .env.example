# Select one source: local (this repository's Fastify + Prisma API), remote
# (a compatible tenant API), or mock (visual demo only).
VITE_DATA_SOURCE=local

# For local Vite development, proxy relative /api requests to Fastify.
VITE_API_PROXY_TARGET=http://127.0.0.1:4000

# Optional remote compatibility mode:
# VITE_DATA_SOURCE=remote
# VITE_API_PROXY_TARGET=https://starforge.78.111.91.113.nip.io
# VITE_API_BASE_URL=
# VITE_AUTH_ENDPOINT=role-login

# Explicit mock mode, useful only for isolated visual work:
# VITE_DATA_SOURCE=mock
