# StarForge EDU staff frontend — production tenant backend.
VITE_DATA_SOURCE=remote
VITE_AUTH_STRATEGY=otp

# Leave blank when the SPA is served from the same tenant domain. Otherwise
# use the tenant origin, for example https://north-campus.example.edu.
VITE_API_BASE_URL=

# Optional local compatibility stack (npm run dev:local sets this automatically)
# VITE_DATA_SOURCE=local
# VITE_API_PROXY_TARGET=http://127.0.0.1:4000

# Explicit visual-only mode. Never use in a deployed environment.
# VITE_DATA_SOURCE=mock
